# Local development defaults — NOT for staging/production.
# Production template: .env.production.example
# Deploy guide: ../docs/deployment.md
APP_NAME=nexabiz-sync-experimental
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL (docker-compose defaults)
DATABASE_URL=postgresql+psycopg2://sync:sync@db:5432/sync_experimental

# Legacy shared bearer (local/dev ONLY). Prefer JWT from /api/v1/auth/login.
# Default in code is false — set true only on trusted developer machines.
# MUST be false when APP_ENV=staging|production (startup will refuse otherwise).
DEV_API_TOKEN=dev-sync-token-change-me
ALLOW_DEV_TOKEN=true
DEFAULT_COMPANY_ID=00000000-0000-4000-8000-000000000001
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000002
DEFAULT_DEVICE_ID=00000000-0000-4000-8000-000000000003

# JWT — change JWT_SECRET before any shared/staging/production deploy
JWT_SECRET=dev-jwt-secret-change-me-please-use-long-random
JWT_ALGORITHM=HS256
JWT_ISSUER=nexabiz-experimental
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Seed bootstrap
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeAdmin!123
SEED_ADMIN_NAME=Platform Admin
SEED_COMPANY_NAME=Demo Company A
SEED_COMPANY_CODE=COMPANY-A
SEED_COMPANY_ID=00000000-0000-4000-8000-000000000001

# Pull page size
SYNC_PULL_LIMIT=500
CORS_ORIGINS=*
