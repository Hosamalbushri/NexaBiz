# Production / staging template — copy to a secrets store or host env.
# NEVER commit the real filled file as `.env` or `.env.production`.
#
#   cp .env.production.example /secure/path/.env.production
#   # edit secrets, then:
#   export $(grep -v '^#' /secure/path/.env.production | xargs)
#   alembic upgrade head
#   uvicorn app.main:app --host 127.0.0.1 --port 8000
#
# Put TLS termination on a reverse proxy (Caddy / nginx / cloud LB).
# Do not expose uvicorn directly to the public internet.

APP_NAME=nexabiz-sync
APP_ENV=production
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Managed PostgreSQL (TLS preferred).
# If PASSWORD contains @ # : / ? encode it (e.g. p@ss → p%40ss):
#   python3 -c "import urllib.parse; print(urllib.parse.quote('YOUR_PASSWORD', safe=''))"
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@127.0.0.1:5432/DBNAME

# MUST stay false in production / staging.
ALLOW_DEV_TOKEN=false
# Leave unused when ALLOW_DEV_TOKEN=false.
DEV_API_TOKEN=

# Cryptographically random (≥ 32 bytes). Generate:
#   openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ISSUER=nexabiz
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Explicit origins only — never "*". Comma-separate multiple app origins.
CORS_ORIGINS=https://test.rawnaqq.com

# Change before first deploy; rotate after staging soak.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_STRONG_PASSWORD
SEED_ADMIN_NAME=Platform Admin
SEED_COMPANY_NAME=Example Company
SEED_COMPANY_CODE=COMPANY-A
# Stable UUID for the seed company (optional override).
SEED_COMPANY_ID=00000000-0000-4000-8000-000000000001

DEFAULT_COMPANY_ID=00000000-0000-4000-8000-000000000001
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000002
DEFAULT_DEVICE_ID=00000000-0000-4000-8000-000000000003

SYNC_PULL_LIMIT=500
AUTH_RATE_LIMIT_PER_MINUTE=20
